{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "skipLibCheck": true, "types": ["node", "obsidian"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "main.js"]
}
