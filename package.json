{
  "name": "garmidian",
  "version": "1.1.0",
  "description": "Garmin dashboard builder for Obsidian: paste a Personal API key, pick sports and metrics, insert a ready Dashy dashboard.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "opdk build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "scorecard:check": "opdk scan",
    "release:check": "opdk release check && npm run scorecard:check && npm run lint && npm run typecheck && npm run test",
    "e2e": "npm run build && playwright test",
    "capture": "npm run build && CAPTURE=1 playwright test capture && opdk demo",
    "readme:check": "node scripts/readme-check.cjs",
    "listing": "node tools/listing.mjs",
    "site:check": "node scripts/site-check.cjs",
    "site:assemble": "node scripts/assemble-site.cjs",
    "site:card": "node scripts/social-card.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "44.10.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "obsidian": "^1.14.4",
    "obsidian-plugin-dev-kit": "github:Dimagious/obsidian-plugin-dev-kit#v0.2.0",
    "obsidian-test-mocks": "8.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
